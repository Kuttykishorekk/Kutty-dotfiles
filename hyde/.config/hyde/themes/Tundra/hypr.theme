$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf

$GTK_THEME=Gtk_Tundra
$ICON_THEME=Zafiro-Nord-Black
$COLOR_SCHEME=prefer-dark
$CURSOR_THEME=volantes_cursors
$CURSOR_SIZE=36

exec = gsettings set org.gnome.desktop.interface icon-theme '$ICON_THEME'
exec = gsettings set org.gnome.desktop.interface gtk-theme '$GTK_THEME'
exec = gsettings set org.gnome.desktop.interface color-scheme '$COLOR_SCHEME'

exec = gsettings set org.gnome.desktop.interface cursor-theme '$CURSOR_THEME'
exec = gsettings set org.gnome.desktop.interface cursor-size $CURSOR_SIZE
exec = hyprctl setcursor $CURSOR_THEME $CURSOR_SIZE


general {
    gaps_in = 0
    gaps_out = 4
    border_size = 0
    # No borders - completely borderless windows
    col.active_border = rgba(00000000)
    col.inactive_border = rgba(00000000)
    layout = dwindle
    resize_on_border = false
}

group {
    # No borders - completely borderless windows
    col.border_active = rgba(00000000)
    col.border_inactive = rgba(00000000)
    col.border_locked_active = rgba(00000000)
    col.border_locked_inactive = rgba(00000000)
}

decoration {
    rounding = 16

    shadow {
        enabled = yes
        offset = 0 1
        range = 25
        render_power = 10
        color = 0xff000000
    }
    blur {
        enabled = yes
        size = 8
        passes = 3
        new_optimizations = on
        ignore_opacity = on
        xray = false
        noise = 0.0117
        contrast = 0.8916
        brightness = 0.8172
        popups = on
        popups_ignorealpha = 0.2
    }
}

layerrule = blur true,match:namespace waybar
